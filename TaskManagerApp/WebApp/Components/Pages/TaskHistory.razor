@page "/tasks/history"
@inject TaskService TaskService
@inject TaskTagService TaskTagService
@inject UserStateService UserStateService

<h3>Task History</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}
else if (_tasks.Count == 0)
{
    <p>No completed tasks found.</p>
}
else
{
    <div class="row task-history-grid">
        @foreach (var task in _tasks)
        {
            var tag = _tags.FirstOrDefault(item => item.Id == task.TaskTagId);
            <div class="col-md-4 mb-3 d-flex">
                <div class="card task-history-card w-100" style="@(tag is null ? null : TagColorStyle.BadgeStyle(tag.Color))">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@task.Title</h5>
                        @if (tag is not null)
                        {
                            <span class="tag-color-badge mb-2 align-self-start" style="@TagColorStyle.BadgeStyle(tag.Color)">@tag.Name</span>
                        }
                        <p class="card-text">@task.Description</p>
                        <p class="text-muted small mt-auto">Completed!</p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<TaskItem> _tasks = new();
    private List<TaskTag> _tags = new();
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var userId = UserStateService.UserId;

        if (string.IsNullOrWhiteSpace(userId))
        {
            _errorMessage = "You must be logged in to view your task history.";
            return;
        }

        try
        {
            _tags = await TaskTagService.GetOrCreateDefaultsAsync(userId);
            _tasks = await TaskService.GetCompletedTasks(userId);
        }
        catch (Exception exception)
        {
            _errorMessage = $"Failed to load completed tasks: {exception.Message}";
        }
    }
}
