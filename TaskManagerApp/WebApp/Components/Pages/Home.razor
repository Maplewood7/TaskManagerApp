@page "/"
@inject UserStateService UserStateService
@inject NavigationManager NavManager

<PageTitle>Task Manager</PageTitle>

<h1>Welcome to Task Manager!</h1>

<p>Your first step towards a more organized and productive life starts here.</p>

@if (UserStateService.GetUser() != null)
{
    <form method="post" action="/account/logout">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-danger">Logout</button>
    </form>
}
else
{
    <p>
        <button type="button" class="btn btn-link p-0" @onclick="OpenLogin">Login</button> |
        <NavLink href="/register">Register</NavLink>
    </p>
}

@code {
    private void Logout()
    {
        UserStateService.ClearUser();
        NavManager.NavigateTo("/");
    }

    private void OpenLogin() =>
        NavManager.NavigateTo("/login", forceLoad: true);
}
