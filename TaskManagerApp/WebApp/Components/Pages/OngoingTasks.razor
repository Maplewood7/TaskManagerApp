@page "/tasks/ongoing"
@inject TaskService TaskService
@inject TaskTagService TaskTagService
@inject UserStateService UserStateService

<h3>Ongoing Tasks</h3>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}
else
{
    <section class="mb-4">
        <h4>Progress by tag</h4>

        @foreach (var progress in GetProgressGroups())
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <strong>@progress.Name</strong>
                    <span>
                        @progress.CompletedCount / @progress.TotalCount completed
                        (@progress.Percentage%)
                    </span>
                </div>
                <div class="progress" aria-label="@($"{progress.Name} progress")">
                    <div class="progress-bar task-progress-bar"
                         role="progressbar"
                         style="@($"width: {progress.Percentage}%; --progress-color: {TagColorStyle.Normalize(progress.Color)};")"
                         aria-valuenow="@progress.Percentage"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>
            </div>
        }
    </section>

    @if (tasks.Count == 0)
    {
        <p>No ongoing tasks.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-3 ongoing-tasks-grid">
            @foreach (var task in tasks)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm ongoing-task-card">
                        <div class="card-body d-flex flex-column justify-content-between">
                            @if (editingTaskId == task.Id)
                            {
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(EditErrorMessage))
                                    {
                                        <div class="alert alert-danger">@EditErrorMessage</div>
                                    }
                                    <div class="mb-3">
                                        <label class="form-label" for="@($"ongoing-title-{task.Id}")">Title</label>
                                        <InputText id="@($"ongoing-title-{task.Id}")" @bind-Value="editTitle" class="form-control" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="@($"ongoing-description-{task.Id}")">Description</label>
                                        <InputTextArea id="@($"ongoing-description-{task.Id}")" @bind-Value="editDescription" class="form-control" />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="@($"ongoing-tag-{task.Id}")">Tag</label>
                                        <InputSelect id="@($"ongoing-tag-{task.Id}")" @bind-Value="editTaskTagId" class="form-select">
                                            <option value="">No tag</option>
                                            @foreach (var tag in tags)
                                            {
                                                <option value="@tag.Id">@tag.Name</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-primary" disabled="@isSavingEdit" @onclick="() => SaveTaskAsync(task)">
                                        @(isSavingEdit ? "Saving..." : "Save")
                                    </button>
                                    <button class="btn btn-outline-secondary" disabled="@isSavingEdit" @onclick="CancelEditing">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <h5 class="card-title">@task.Title</h5>

                                    @if (task.TaskTagId is int taskTagId)
                                    {
                                        var tag = tags.FirstOrDefault(tag => tag.Id == taskTagId);
                                        @if (tag is not null)
                                        {
                                            <span class="tag-color-badge" style="@TagColorStyle.BadgeStyle(tag.Color)">@tag.Name</span>
                                        }
                                    }

                                    @if (!string.IsNullOrWhiteSpace(task.Description))
                                    {
                                        <p class="card-text mt-2">@task.Description</p>
                                    }
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <button class="btn btn-outline-primary" @onclick="() => StartEditing(task)">Edit</button>
                                    <button class="btn btn-success"
                                            @onclick="() => CompleteTaskAsync(task)">
                                        Complete
                                    </button>
                                    <button class="btn btn-outline-danger"
                                            @onclick="() => RemoveTaskAsync(task)">
                                        Remove
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<TaskItem> tasks = new();
    private List<TaskItem> allTasks = new();
    private List<TaskTag> tags = new();
    private string ErrorMessage = string.Empty;
    private string EditErrorMessage = string.Empty;
    private string editTitle = string.Empty;
    private string? editDescription;
    private int? editTaskTagId;
    private int? editingTaskId;
    private bool isSavingEdit;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = UserStateService.UserId;

            if (string.IsNullOrWhiteSpace(userId))
            {
                ErrorMessage = "You must be logged in to see your tasks.";
                return;
            }

            tags = await TaskTagService.GetOrCreateDefaultsAsync(userId);
            allTasks = await TaskService.GetAllTasks(userId);
            tasks = allTasks.Where(task => !task.IsCompleted).ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load tasks: {ex.Message}";
        }
    }

    private async Task CompleteTaskAsync(TaskItem task)
    {
        try
        {
            await TaskService.CompleteTask(task);
            tasks.Remove(task);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to complete task: {ex.Message}";
        }
    }

    private void StartEditing(TaskItem task)
    {
        EditErrorMessage = string.Empty;
        editTitle = task.Title;
        editDescription = task.Description;
        editTaskTagId = task.TaskTagId;
        editingTaskId = task.Id;
    }

    private void CancelEditing()
    {
        editingTaskId = null;
        EditErrorMessage = string.Empty;
    }

    private async Task SaveTaskAsync(TaskItem task)
    {
        EditErrorMessage = string.Empty;
        isSavingEdit = true;

        try
        {
            var userId = UserStateService.UserId;

            if (string.IsNullOrWhiteSpace(userId))
            {
                EditErrorMessage = "You must be logged in to edit a task.";
                return;
            }

            await TaskService.UpdateTaskAsync(task.Id, userId, editTitle, editDescription, editTaskTagId);
            task.Title = editTitle.Trim();
            task.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
            task.TaskTagId = editTaskTagId;
            editingTaskId = null;
        }
        catch (Exception ex)
        {
            EditErrorMessage = ex.Message;
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private async Task RemoveTaskAsync(TaskItem task)
    {
        try
        {
            var userId = UserStateService.UserId;

            if (string.IsNullOrWhiteSpace(userId))
            {
                ErrorMessage = "You must be logged in to remove a task.";
                return;
            }

            await TaskService.DeleteTaskAsync(task.Id, userId);
            tasks.Remove(task);
            allTasks.Remove(task);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to remove task: {ex.Message}";
        }
    }

    private IEnumerable<(string Name, int CompletedCount, int TotalCount, int Percentage, bool IsUntagged, string Color)> GetProgressGroups()
    {
        var groups = new List<(string Name, int CompletedCount, int TotalCount, int Percentage, bool IsUntagged, string Color)>();

        foreach (var tag in tags)
        {
            var tagTasks = allTasks.Where(task => task.TaskTagId == tag.Id).ToList();
            var completedCount = tagTasks.Count(task => task.IsCompleted);
            var percentage = tagTasks.Count == 0
                ? 0
                : (int)Math.Round(completedCount * 100.0 / tagTasks.Count);

            groups.Add((tag.Name, completedCount, tagTasks.Count, percentage, false, tag.Color));
        }

        var untaggedTasks = allTasks.Where(task => task.TaskTagId is null).ToList();

        if (untaggedTasks.Count > 0)
        {
            var completedCount = untaggedTasks.Count(task => task.IsCompleted);
            var percentage = (int)Math.Round(completedCount * 100.0 / untaggedTasks.Count);

            groups.Add(("Untagged existing tasks", completedCount, untaggedTasks.Count, percentage, true, "#9CA3AF"));
        }

        return groups
            .OrderByDescending(group => group.Percentage)
            .ThenBy(group => group.Name);
    }
}
